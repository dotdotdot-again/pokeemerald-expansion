mapscripts PlayerHouseF2_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_TEMP_4, 0:trigger_test
	]
    MAP_SCRIPT_ON_TRANSITION: OnTransitionTest
    	MAP_SCRIPT_ON_FRAME_TABLE [
	VAR_TEMP_2, 0:EveryFrameTest
	]
}

script trigger_test{
	applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    removeobject(BarryIntroOne)
	//waitmovement(0)

}

script OnTransitionTest{
	
	setvar(VAR_TEMP_2,0)
    
}

script EveryFrameTest {

    if(var(VAR_TWINLEAF_INTRO_STATE) == 0)
	{
        lockall
	    setflag(FLAG_RECEIVED_RUNNING_SHOES)
	    setflag(FLAG_SYS_B_DASH)
        playbgm(MUS_ENCOUNTER_INTERVIEWER, 0)
        setspeaker("Newscaster")
	    msgbox("\qoPok\emon are by our side, always.\n I hope you will understand the meaning\l of those words.\qc\p" 
        "That was the comment left by Prof.\n Rowan, who has returned to Sinnoh from\l the Kanto Region.\p"
        "That concludges our special program,\n \qoLet's Ask Prof. Rowan!\qc\p"
        "Brought to you by Jubilife TV\n on Nationwide Net!\p"
        "See You next week,\n same time, same channel")
	    waitmessage
        closemessage
        fadedefaultbgm
        setvar(VAR_TWINLEAF_INTRO_STATE, 1)
	    releaseall	
    }
    else{
        setvar(VAR_TEMP_2, 1)
    }
}
// look i KNOW this is the wrong way t odo this but i am lazy atm 
//if player walks right
script BarryWalksRight {
        lockall
        playbgm(MUS_ENCOUNTER_BRENDAN, 0)
        addobject(BarryIntroOne)
        applymovement(BarryIntroOne, moves(emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        setspeaker(SP_NAME_BARRY)
	    msgbox(fromat("There you are!"))
        waitmessage
        closemessage
        applymovement(BarryIntroOne, moves(walk_fast_left*2,walk_fast_down,face_left))
        waitmovement
        setspeaker(SP_NAME_BARRY)
	    msgbox(BarryOne)
        waitmessage
        closemessage
        applymovement(BarryIntroOne, moves(emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        applymovement(BarryIntroOne, moves(walk_fast_down,walk_fast_left*5,walk_fast_up*2,face_up))
        waitmovement
        applymovement(OBJ_EVENT_ID_PLAYER,moves(face_left))
        waitmovement
        setspeaker(SP_NAME_BARRY)
	    msgbox(fromat("Oh, hey!\n"
        "Is this a new PC?!"))
        waitmessage
        applymovement(BarryIntroOne, moves(face_right))
        waitmovement
        setspeaker(SP_NAME_BARRY)
	    msgbox(fromat("Uh...\n"
        "Where was I?"))
        waitmessage
        applymovement(BarryIntroOne, moves(walk_fast_down,walk_fast_right*3))
        waitmovement
        setspeaker(SP_NAME_BARRY)
        msgbox(BarryLast)
        waitmessage
        closemessage
        applymovement(BarryIntroOne, moves(walk_fast_down,walk_fast_right*3,walk_fast_up*2,walk_fast_right))
        waitmovement
        playse(SE_EXIT) 
        removeobject(BarryIntroOne)
        applymovement(OBJ_EVENT_ID_PLAYER,moves(face_right))
        fadedefaultbgm
        setflag(FLAG_UNUSED_0x020)
        setvar(VAR_TWINLEAF_INTRO_STATE, 2)
        releaseall	
}
//player walks left
script BarryWalksLeft {
        lockall
        playbgm(MUS_ENCOUNTER_BRENDAN, 0)
        addobject(BarryIntroOne)
        applymovement(OBJ_EVENT_ID_PLAYER,moves(face_right))
        applymovement(BarryIntroOne, moves(emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        setspeaker(SP_NAME_BARRY)
	    msgbox(fromat("There you are!"))
        waitmessage
        closemessage
        applymovement(BarryIntroOne, moves(walk_fast_down,walk_fast_left*4,face_left))
        waitmovement
        setspeaker(SP_NAME_BARRY)
	    msgbox(BarryOne)
        waitmessage
        closemessage
        applymovement(BarryIntroOne, moves(emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        applymovement(BarryIntroOne, moves(walk_fast_up,walk_fast_left*3,,face_up))
        waitmovement
        applymovement(OBJ_EVENT_ID_PLAYER,moves(face_left))
        waitmovement
        setspeaker(SP_NAME_BARRY)
	    msgbox(fromat("Oh, hey!\n"
        "Is this a new PC?!"))
        waitmessage
        applymovement(BarryIntroOne, moves(face_right))
        setspeaker(SP_NAME_BARRY)
	    msgbox(fromat("Uh...\n"
        "Where was I?"))
        waitmessage
        applymovement(BarryIntroOne, moves(walk_fast_down,walk_fast_right))
        waitmovement
        setspeaker(SP_NAME_BARRY)
        msgbox(BarryLast)
        waitmessage
        closemessage
        applymovement(BarryIntroOne, moves(walk_fast_down,walk_fast_right*5,walk_fast_up*2,walk_fast_right))
        waitmovement
        playse(SE_EXIT) 
        removeobject(BarryIntroOne)
        applymovement(OBJ_EVENT_ID_PLAYER,moves(face_right))
        fadedefaultbgm
        setflag(FLAG_UNUSED_0x020)
        setvar(VAR_TWINLEAF_INTRO_STATE, 2)
        releaseall	
}

