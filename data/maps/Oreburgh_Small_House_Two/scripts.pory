mapscripts Oreburgh_Small_House_Two_MapScripts {}

script OreburghCityMiddleHouse_Text_RoarkIsAUserOfRockTypePokemon {
    lock
    msgbox("Roark is a user of Rock-type Pokémon.\p"
        "Don’t you think Rock-type Pokémon are\n"
        "nice? I like how lumpy they are!",MSGBOX_NPC)
    release
}

script OreburghCityMiddleHouse_Text_RoarkIsOurTownsGymLeader {
    lock
    msgbox("Roark is our town’s Gym Leader.\p"
        "He may be young, but he keeps the\n"
        "mine running safely and efficiently.",MSGBOX_NPC)
    release
}