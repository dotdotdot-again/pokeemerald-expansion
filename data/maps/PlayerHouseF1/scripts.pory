mapscripts PlayerHouseF1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: OnTransitionPlayerHouseF1
    	MAP_SCRIPT_ON_FRAME_TABLE [
	VAR_TEMP_2, 0:EveryFrameMom
	]
}

script OnTransitionPlayerHouseF1{
	
	setvar(VAR_TEMP_2,0)
    
}

script EveryFrameMom {
    if(var(VAR_TWINLEAF_INTRO_STATE) == 2)
    {
        lockall
        setrespawn(HEAL_LOCATION_PLAYER_HOUSE_F1)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
        waitmovement
        applymovement(Mom, moves(emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        applymovement(Mom, moves(walk_up,walk_right*3,walk_up*3))
        waitmovement
        setspeaker(SP_NAME_MOM)
	    msgbox("{PLAYER}!\p"
        "Barry already left.\p"
        "I don’t know what it was about, but\n"
        "he sure was in a hurry!",MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(Mom, moves(walk_down*3,walk_left*3,walk_down,face_up))
        waitmovement
        setvar(VAR_TWINLEAF_INTRO_STATE, 3)
        releaseall
    }
    elif(var(VAR_TWINLEAF_INTRO_STATE) == 7)
    {
        //fadescreen(FADE_TO_BLACK)
        setobjectxy(Mom,2,4)
        setobjectxy(Moms_Cat,1,4)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
        //fadescreen(FADE_TO_FROM)
        call(after_starter)
    }
    else
    {
        setvar(VAR_TEMP_2, 1)
    }
}

script TalkMom {
    if(var(VAR_TWINLEAF_INTRO_STATE) == 3)
    {
        lock
        setspeaker(SP_NAME_MOM)
        msgbox("You know how impatient\n"
        "Barry is.\p"
        "He took off before I could even\n"
        "ask what it was about.",MSGBOX_NPC)
        release
    }
    elif(var(VAR_TWINLEAF_INTRO_STATE) == 4 || var(VAR_TWINLEAF_INTRO_STATE) == 5 || var(VAR_TWINLEAF_INTRO_STATE) == 6)
    {
         lock
        setspeaker(SP_NAME_MOM)
        msgbox("What is it, dear?\n"
        "Isn’t Barry waiting for you?",MSGBOX_NPC)
        release
    }
    elif(var(VAR_SANDGEM_INTRO_STATE) == 2)
    {
        lock
        applymovement(Mom, moves(face_player))
        setspeaker(SP_NAME_MOM)
        msgbox("Welcome home, {PLAYER}.\n"
        "Are you and your Pokémon healthy?\p"
        "It’s so late right now...\n"
        "Take a quick rest, dear.",MSGBOX_AUTOCLOSE)
        waitmessage
        fadescreen(FADE_TO_BLACK)
        special(HealPlayerParty)
        applymovement(Moms_Cat, moves(face_player))
        playfanfare(MUS_HEAL)
        waitfanfare
        fadescreen(FADE_FROM_BLACK)
        setspeaker(SP_NAME_MOM)
        msgbox("What is it, {PLAYER}?\p"
        "...\p"
        "Wow. Professor Rowan asked you\n"
        "to do something that big.\p"
        "OK, dear, go for it!\n"
        "Your mom’s got your back!\p"
        "Oh, I know! {PLAYER}, I’ve got\n"
        "something that you’ll find useful.",MSGBOX_AUTOCLOSE)
        waitmessage
        playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} obtained\n"
        "the{COLOR BLUE}{SHADOW LIGHT_BLUE}Journal{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}!")
	waitfanfare
    setflag(FLAG_SYS_QUEST_MENU_GET)
    setspeaker(SP_NAME_MOM)
        msgbox("That’s my old Journal.\n"
        "You can use it to keep a record\l"
        "of your daily events.\p"
        "Check it, and you’ll be able to\n"
        "remember what you need to do.\p"
        "It can also be helpful to keep track of\n"
        "any tasks or requests you're given on\l"
        "your adventure.\p"
        "In fact, let me write down that Pok\edex\n"
        "task for you right now.")
    waitmessage
    startquest(QUEST_COMPLETE_DEX)
    applymovement(Mom, moves(face_away_player))
    applymovement(Moms_Cat, moves(face_left))
    waitmovement
    setspeaker(SP_NAME_MOM)
        msgbox("Gee, a journey full of adventure...\n"
        "I envy you, kiddo.\p"
        "Plus, you’re not alone.\n"
        "You have your Pokémon with you.\l"
        "I wish I could go instead!",MSGBOX_AUTOCLOSE)
     waitmessage
    applymovement(Mom, moves(face_player))
    waitmovement
        setspeaker(SP_NAME_MOM)
        msgbox("I’m just joking, dear!\n"
        "Yup, {PLAYER}!\p"
        "I’ll be all right here with Glammy, so you\n"
        "go and enjoy your adventure!\p"
        "When you’re exposed to new things,\n"
        "and experience new sensations...\l"
        "It makes your mother happy, too.\p"
        "...But come back sometimes.\p"
        "I would like to see the kinds of\n"
        "Pokémon you’ve caught, dear.",MSGBOX_AUTOCLOSE)
        waitmessage
        playse(SE_DOOR)
        clearflag(FLAG_UNUSED_0x020)
        addobject(barryMom)
        applymovement(Mom, moves(face_down,emote_exclamation_mark))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down,emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        waitmovementall
        applymovement(barryMom, moves(walk_up,face_left,delay_16,face_right,delay_16))
        waitmovementall
        setspeaker("Barry's Mom")
        msgbox("Excuse me.\n"
        "Is my little Barry here?",MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(Mom, moves(walk_in_place_down))
        waitmovement
        setspeaker(SP_NAME_MOM)
        msgbox("Oh?\n"
        "No, he’s not...",MSGBOX_AUTOCLOSE)
        waitmessage
        setspeaker("Barry's Mom")
        msgbox("Oh...\n"
        "Then, he must have left already...\l"
        "What to do...\p"
        "That boy shouted about going on an\n"
        "adventure, then he bolted.\p"
        "He’s so headstrong and reckless...\n"
        "I at least wanted him to take this...",MSGBOX_AUTOCLOSE)
        waitmessage
        setspeaker(SP_NAME_MOM)
        msgbox("Not to worry, {PLAYER} will\n"
        "deliver that to him.")
        waitmessage
        applymovement(Mom, moves(face_player))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_original_direction))
        setspeaker(SP_NAME_MOM)
        msgbox("Won’t you, {PLAYER}?",MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(barryMom, moves(face_player))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
        setspeaker("Barry's Mom")
        msgbox("Oh, really?\n"
        "You’d do that for me?\p"
        "{PLAYER}, please take this to\n"
        "Barry for me.",MSGBOX_AUTOCLOSE)
        waitmessage
        giveitem(ITEM_PARCEL)
        setspeaker(SP_NAME_MOM)
        msgbox("Bye-bye, {PLAYER}!\n"
        "Enjoy your adventure!",MSGBOX_AUTOCLOSE)
        waitmessage
        setspeaker("Barry's Mom")
        msgbox("Let me think...\p"
        "Knowing my boy, he would probably\n"
        "head straight to Jubilife City...\p"
        "OK, please take that to my\n"
        "Barry.",MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(barryMom, moves(walk_down))
        waitmovement
        playse(SE_DOOR)
        setflag(FLAG_UNUSED_0x020)
        removeobject(barryMom)
        waitse
        setvar(VAR_SANDGEM_INTRO_STATE,3)
        release
    }
    else{
          lock
        setspeaker(SP_NAME_MOM)
        msgbox("Let me heal your pokemon for you.",MSGBOX_NPC)
        waitmessage
        fadescreen(FADE_TO_BLACK)
        special(HealPlayerParty)
        playfanfare(MUS_HEAL)
        waitfanfare
        fadescreen(FADE_FROM_BLACK)
        msgbox("Have fun sweetie.",MSGBOX_NPC)
        waitmessage
        release       
    }
}

script PlayerHouseTVF1 {
    if(var(VAR_TWINLEAF_INTRO_STATE) == 3)
    {
        lock
        setspeaker("MC")
        msgbox("Here we are!\n"
        "It's the contest Digest!\p"
        "The winner of today's Normal Rank\n"
        "Tough Contest is...\p"
        "Dominic, who overwhelmed with his\n"
        "awesomely buffed Pokémon!\p"
        "That's all the time we have today!\n"
        "Let's meet again!",MSGBOX_SIGN)
        release
    }
}

script triggerMomTryToLeave{
    lockall
    applymovement(Mom, moves(emote_exclamation_mark,face_down))
    playse(SE_PIN) 
    waitse
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement
    setspeaker(SP_NAME_MOM)
    msgbox("Oh, yes!\n"
        "{PLAYER}!\p"
        "Don’t go into the tall grass.\n"
        "Wild Pokémon might attack you.\p"
        "It would be OK if you had your own\n"
        "Pokémon, but you don’t, so...\p"
        "Well, take care, sweetie!")
    closemessage
    waitmessage
    setvar(VAR_TWINLEAF_INTRO_STATE, 4)
    releaseall

}

script after_starter {
    playmoncry(SPECIES_GLAMEOW,0)
    applymovement(Mom, moves(walk_up,delay_16,walk_left,face_up,delay_16,walk_right*3,walk_down,walk_right,walk_down*3,walk_right*2,walk_down,face_left))
    applymovement(Moms_Cat, moves(jump_in_place_up*2,delay_16*3,walk_up,walk_right*3,walk_down,walk_right,walk_down*3,walk_right*3,walk_down,face_left,jump_in_place_left*2))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_16*9,walk_right*3,walk_down,walk_down,walk_right))
    waitmovementall
    setspeaker(SP_NAME_MOM)
    msgbox("What’s the matter, dear?\p"
        "...\p"
        "Wow.\n"
        "That’s what happened to you?\p"
        "You and Barry are lucky to have\n"
        "met Prof. Rowan.\p"
        "Imagine if you didn’t...\p"
        "I wouldn’t like to think what the wild\n"
        "Pokémon might have done to you two.\p"
        "{PLAYER}, go see Prof. Rowan, and\n"
        "thank him properly for your Pokémon.\p"
        "His lab is in Sandgem Town, isn’t it?\p"
        "Now that you have your own Pokémon,\n"
        "the tall grass won’t be so threatening.")
    setspeaker(SP_NAME_MOM)
    msgbox("Oh, and why don't you try letting\n"
        "your Pokémon walk around with you\l"
        "outside of it's ball for a bit?\p"
        "It may help the two of you grow\n"
        "closer together.\p"
        "And I'm sure they wouldn't mind\n"
        "getting to stretch their legs\l"
        "a little bit too.")
    waitmessage
    applymovement(Mom, moves(face_right))
    setspeaker(SP_NAME_MOM)
    msgbox("I know sweet little Glammy here loves\n"
    "getting to walk around out of her ball,\l"
    "don't you Glammy?")
    waitmessage
    playmoncry(SPECIES_GLAMEOW,0)
    applymovement(Moms_Cat, moves(emote_heart,jump_in_place_left*2))
    setspeaker("Glammy")
    msgbox("Mrow Meow!")
    waitmessage
    applymovement(Mom, moves(face_left))
    setspeaker(SP_NAME_MOM)
    msgbox("And if you need any healing just come\n"
    "back to me and I'll fix you two right up.",MSGBOX_AUTOCLOSE)
    waitmessage
    setvar(VAR_TWINLEAF_INTRO_STATE, 8)
    releaseall
}

script PlayerHouseF1_Meow {
    lock
    if(var(VAR_TWINLEAF_INTRO_STATE) == 8 && var(VAR_SANDGEM_INTRO_STATE) > 2){
    playmoncry(SPECIES_GLAMEOW,0)
    setspeaker("Glammy")
    applymovement(Moms_Cat, moves(emote_heart))
    msgbox("Meorw Merooow!!\p"
    "\qoGlammy seems happy you\n"
    "are ok.\qc",MSGBOX_NPC)
    }
    elif(var(VAR_SANDGEM_INTRO_STATE) == 3){
    playmoncry(SPECIES_GLAMEOW,0)
    setspeaker("Glammy")
    applymovement(Moms_Cat, moves(emote_double_exclamation_mark))
    msgbox("Mrrow!!! Mmmmrow!\p"
    "\qoGlammy seems sad to see you go\p"
    "and a little jeleous of your new\n"
    "Pok\emon.\qc",MSGBOX_NPC)
    }
    else{
    playmoncry(SPECIES_GLAMEOW,0)
    setspeaker("Glammy")
    applymovement(Moms_Cat, moves(emote_heart))
    msgbox("Meorw!\p"
    "\qoGlammy seems happy to\n"
    "see you\qc",MSGBOX_NPC)
    release

    }

}
