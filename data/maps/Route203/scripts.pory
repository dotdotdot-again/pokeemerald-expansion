mapscripts Route203_MapScripts {

}

script Route203_Barry_Encounter {
    lockall
    applymovement(Barry_203, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitse
    waitmovement
    playbgm(MUS_DP_RIVAL, 0)
    getobjectcurrentxy(OBJ_EVENT_ID_PLAYER,VAR_TEMP_6,VAR_TEMP_7,VAR_TEMP_8)
    if(var(VAR_TEMP_8) == 24)
    {  
        applymovement(Barry_203, moves(walk_fast_down*1,walk_fast_left*4))
        waitmovement
    }
    elif(var(VAR_TEMP_8) == 25)
    {
        applymovement(Barry_203, moves(walk_fast_down*2,walk_fast_left*4))
        waitmovement
    }
    else
    {
        applymovement(Barry_203, moves(walk_fast_left*4))
        waitmovement
    }
    
    setspeaker(SP_NAME_BARRY)
    msgbox("Hey! {PLAYER}!\n"
        "Tell me you got a little tougher!\p"
        "Me? Do you even need to ask?\n"
        "Of course I got tougher!\p"
        "Come on!\n"
        "I’ll demonstrate it o you!",MSGBOX_AUTOCLOSE)
        waitmessage
    switch(var(VAR_STARTER_MON)) {
        case 0:
            trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_103_TREECKO, "What are you saying?!\nWe ended up losing?!")
        case 1:
            trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_110_TORCHIC, "What just happen?\nI lost?!")
        case 2:
            trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_103_MUDKIP, "What are you saying?!\nWe ended up losing?!")
    }
    call(Route203_Barry_Encounter_Count)
    
}

script Route203_Barry_Encounter_Count {
        setspeaker(SP_NAME_BARRY)
    msgbox("Waah!\n"
        "What do you mean I lost?!\p"
        "Well, that’s it!\n"
        "That’s the last time I’ll ever lose!\p"
        "I’m going to be the world’s toughest\n"
        "Trainer, and you know it!\p"
        "The first thing to do is take on\n"
        "the Oreburgh City Pokémon Gym!\p"
        "I’m gonna toughen up for that,\n"
        "totally!",MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(Barry_203, moves(walk_fast_right*7))
        waitmovement
        removeobject(Barry_203)
        setflag(FLAG_BARRY_R203)
        setvar(VAR_JUBILIFE_STATE,5)
}

script Route203_Youngster_Michael {
    trainerbattle_single(TRAINER_JOSH, "I get my get-up-and-go from my\n"
                "Pokémon!\p"
                "Here we go!\n"
                "Kricketot! Murkrow!", "Ack! My Pokémon...")
    msgbox("Keep out of the grass or dodge the\n"
                "eyes of Trainers...?\p"
                "I always have a tough time choosing.",MSGBOX_NPC)
    waitmessage
    release
}

script Route203_Youngster_Dallas {
    trainerbattle_single(TRAINER_TOMMY, "I’m never apart from my Houndour.\n"
                "Our bond is strong!", "So sad...\n"
                "And so crushed...")
    msgbox("I don’t bear grudges over losing.\n"
            "But I promise I’ll get tougher!",MSGBOX_NPC)
    waitmessage
    release
}


script Route203_Youngster_Sebastian {
    trainerbattle_single(TRAINER_JOEY, "Before I challenge the Pokémon Gym\n"
                "Leader, I’ll test my strength on you!", "I guess it means I’m not ready for\n"
                "the Gym challenge yet...")
    msgbox("I guess if you don’t have a single\n"
                "Gym Badge, you’re a total nobody...",MSGBOX_NPC)
    waitmessage
    release
}

script Route203_Lass_Kaitlin {
    trainerbattle_single(TRAINER_HALEY_1, "I found a Trainer while looking for\n"
                "some Pokémon!", "Hunh? You’re finished so soon?")
    msgbox("I walk through tall grass until I\n"
                "find the Pokémon I want.",MSGBOX_NPC)
    waitmessage
    release
}

script Route203_Lass_Madeline {
    trainerbattle_single(TRAINER_JANICE, "I got a nifty-keen Gym Badge from\n"
                "the Gym Leader in Oreburgh City!", "Oh, I lost! Lalala!")
    msgbox("I’m collecting lots of Gym Badges.\n"
                "They’re so sparkly and pretty!",MSGBOX_NPC)
    waitmessage
    release
}

