mapscripts TwinleafTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION:OnTransitionTwinleaf
}



script OnTransitionTwinleaf
{
    removeobject(Twinleaf_Thud_Barry)
    setflag(BARRY_INTRO_TWO)
}

script Twinleaf_fatman {
    lock
    msgbox("Technology just blows me away!\p"
        "I mean, now you can play with people\n"
        "around the world...wirelessly!",MSGBOX_NPC)
        release

}

script Twinleaf_playerHouseSign {
    lock
    msgbox("{PLAYER}'s House",MSGBOX_SIGN)
    release
}

script Twinleaf_barryHouseSign {
    lock
    msgbox("Barry's House",MSGBOX_SIGN)
    release
}

script Twinleaf_Town_Sign {
    lock
    msgbox("Twinleaf Town\n"
    "Fresh and Free!",MSGBOX_SIGN)
    release
}

script Twinleaf_outside_lady {
    lock
    msgbox("It’s true that wild Pokémon do attack\n"
        "people sometimes...\p"
        "But, Pokémon also open their hearts\n"
        "to you, so you can become friends.",MSGBOX_NPC)
        release

}

script Twinleaf_outside_guy {
    lock
    if(var(VAR_TWINLEAF_INTRO_STATE) == 4 || var(VAR_TWINLEAF_INTRO_STATE) == 5)
    {
    msgbox("Hiya, {PLAYER}.\n"
    "Barry was looking for you.\p"
    "I think he’s home now.\n"
    "Why don’t you go check it out?",MSGBOX_NPC)
    release
    }
    elif(var(VAR_TWINLEAF_INTRO_STATE) == 6)
    {
    msgbox("Hiya, {PLAYER}.\n"
    "You're looking for Barry?\p"
    "He just went tear off a little\n"
    "while ago.\p"
    "He's probably not gone too far.\n"
    "Why not go chase after him?",MSGBOX_NPC)
    }
    elif(var(VAR_TWINLEAF_INTRO_STATE) == 10)
    {
    msgbox("Barry? He went tearing off\n"
    "in a huge rush a while ago.\p"
    "...Ouch. He ran right into me earlier.\n"
    "It's still hurting.\l"
    "That kid's growing up tough.",MSGBOX_NPC)
    }



}

text barryWasLooking
{
    "Hiya, {PLAYER}.\n"
    "Barry was looking for you.\p"
    "I think he’s home now.\n"
    "Why don’t you go check it out?"
    
}

script Twinleaf_trigger_trytoleaveguy {
    lock
    applymovement(Tiwnleaf_outside_guy, moves(emote_exclamation_mark,face_up))
    playse(SE_PIN) 
    waitse
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement
    msgbox(barryWasLooking,MSGBOX_NPC)
    waitmessage
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
    waitmovement
    release
}

script Twinleaf_Barry_Thud {
    lockall
    opendoor(9,8)
    addobject(Twinleaf_Thud_Barry)
    clearflag(BARRY_INTRO_TWO)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down,face_down))
    applymovement(Twinleaf_Thud_Barry, moves(walk_down))
    waitmovementall
    msgbox("THUD!!",MSGBOX_NPC)
    waitmessage
    playbgm(MUS_ENCOUNTER_BRENDAN,0)
    applymovement(Twinleaf_Thud_Barry, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
    setspeaker(SP_NAME_BARRY)
    msgbox("What was that about?!\p"
    "Oh, hey, {PLAYER}!\p"
    "Hey! I’m going to see Prof. Rowan!\n"
    "You should come, too! And quickly!",MSGBOX_NPC)
    applymovement(Twinleaf_Thud_Barry, moves(walk_fast_right*4))
    waitmovement
    applymovement(Twinleaf_Thud_Barry, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
    waitmovement
    applymovement(Twinleaf_Thud_Barry, moves(walk_fast_left*4,face_down))
    setspeaker(SP_NAME_BARRY)
    msgbox("Oh, jeez!\n"
    "Forgot something!",MSGBOX_NPC)
    waitmessage
    applymovement(Twinleaf_Thud_Barry, moves(walk_fast_up))
    waitmovement
    closedoor(9,8)
    fadedefaultbgm
    waitmovement
    removeobject(Twinleaf_Thud_Barry)
    setflag(Twinleaf_Thud_Barry)
    setvar(VAR_TWINLEAF_INTRO_STATE, 5)
    releaseall
}

script Twinleaf_removeBarry {
    hideobjectat(Twinleaf_Thud_Barry,MAP_TWINLEAF_TOWN)
    setvar(VAR_TEMP_2, 1)
}