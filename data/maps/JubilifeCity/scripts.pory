script Jubilife_Poketkch_man_Cont {
	msgbox("Oh, oh, oh?\p"
        "You call yourself a Pokémon Trainer?\n"
        "And yet you have no Pokétch?\p"
        "That is, Pokémon Watch, or Pokétch\n"
        "for short!\p"
        "Oh my, you are a rare case\n"
        "indeed!")
		msgbox("You see, I invented, and now\n"
        "manufacture, Pokétches.\p"
        "Not only that, I’m now conducting\n"
        "the Pokétch promotional campaign!\p"
        "All you have to do is find three\n"
        "clowns in Jubilife City.\p"
        "If you can find them...\n"
        "I will gift you with a Pokétch!",MSGBOX_AUTOCLOSE)
	setvar(VAR_JUBILIFE_STATE,3)
	releaseall
}

script Jubilife_Poketkch_man_During_Hunt {
	if(flag(FLAG_CLOWN_TWO) == TRUE && flag(FLAG_CLOWN_ONE) == TRUE && flag(FLAG_CLOWN_THREE) == TRUE)
	{
		lockall
		applymovement(poketch_president_outside, moves(face_player))
		msgbox("OK, let me count your Coupons!\n"
        "I’ll use the Pokétch here...\p"
        "One, two, three!\n"
        "Bravo! I say, bravo!\p"
        "In return for these Coupons,\n"
        "I present you this Pokémon Watch,\l"
        "or Pokétch for short!")
		waitmessage
		playfanfare(MUS_OBTAIN_ITEM)
		msgbox("{PLAYER} received\n"
        "the {COLOR RED}{SHADOW LIGHT_RED}Pokétch{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}!")
		waitfanfare
		removeitem(ITEM_EON_TICKET)
		removeitem(ITEM_MYSTIC_TICKET)
		removeitem(ITEM_AURORA_TICKET)
		setflag(FLAG_SYS_POKENAV_GET)
		msgbox("You can add apps to your Pokétch\n"
        "to make it even more versatile!\p"
        "Touch the Pokétch screen and find the\n"
        "apps that are right for you!",MSGBOX_AUTOCLOSE)
		waitmessage
    	getobjectfacingdirection(OBJ_EVENT_ID_PLAYER,VAR_JUBILIFE_STATE)
		   if(var(VAR_JUBILIFE_STATE) == 1)
			{
				applymovement(poketch_president_outside, moves(walk_left*1,walk_up*7))
				waitmovement
			}
			else
			{
				applymovement(poketch_president_outside, moves(walk_up*7))
				waitmovement  
			}
		removeobject(poketch_president_outside)
		setvar(VAR_JUBILIFE_STATE,4)
		setflag(FLAG_JUBILIFE_POKETKCH)
		setflag(FLAG_JUBILIFE_LOOKER_BLOCK)
		releaseall
		
	}
	else
	{
	lock
		msgbox("The three clowns will each ask you\n"
        "a skill-testing question.\p"
        "The questions will all have to do\n"
        "with Pokémon.\p"
        "After all, a Pokétch is a tool for\n"
        "Pokémon Trainers.\p"
        "Collect a Coupon from each clown,\n"
        "then come see me, OK?",MSGBOX_NPC)
	release

	}

}

script Clown_Two_text {
	lock
	if(flag(FLAG_CLOWN_TWO) == FALSE)
	{
		applymovement(Clown_Two, moves(face_player))
		msgbox("Hi! I’m a Pokétch campaign clown!\n"
        "Let’s roll out my question!\p"
        "Does a Pokémon grow by defeating\n"
        "others and gaining Exp. Points?",MSGBOX_YESNO)
		if(var(VAR_RESULT) == 1)
		{
			msgbox("Ding-ding!\n"
			"You’re absolutely correct!")
			msgbox("Pokémon grow stronger by defeating\n"
			"other Pokémon in battle.\p"
			"Some Pokémon even grow into an\n"
			"entirely different form in a process\l"
			"known as evolution.")
			msgbox("Here you go!\n"
			"Your Pokétch Coupon!")
			waitmessage
			setflag(FLAG_CLOWN_TWO)
			giveitem(ITEM_EON_TICKET)
		}
		elif(var(VAR_RESULT) == 0)
		{
			msgbox("Bzzzzt!\n"
			"That’s the wrong answer...",MSGBOX_AUTOCLOSE)
			waitmessage
		}
	}
	else
	{
			msgbox("Pokémon grow stronger by defeating\n"
			"other Pokémon in battle.\p"
			"Some Pokémon even grow into an\n"
			"entirely different form in a process\l"
			"known as evolution.",MSGBOX_NPC)
			waitmessage

	}
	release
}

script Clown_One_text {
	lock
	if(flag(FLAG_CLOWN_ONE) == FALSE && flag(FLAG_CLOWNS) == FALSE)
	{
		applymovement(Clown_One, moves(face_player))
		msgbox("Hi! I’m a Pokétch campaign clown!\n"
        "Let’s roll out my question!\p"
        "Just like Pokémon types, the moves\n"
        "of Pokémon also have types?",MSGBOX_YESNO)
		if(var(VAR_RESULT) == 1)
		{
		msgbox("Ding-ding!\n"
		"You’re absolutely correct!")
		msgbox("If the Pokémon’s type matches its\n"
        "move’s type, that move is made much\l"
        "more powerful!")
			msgbox("Here you go!\n"
			"Your Pokétch Coupon!")
			waitmessage
			setflag(FLAG_CLOWN_ONE)
			giveitem(ITEM_MYSTIC_TICKET)
		}
		elif(var(VAR_RESULT) == 0)
		{
			msgbox("Bzzzzt!\n"
			"That’s the wrong answer...",MSGBOX_AUTOCLOSE)
			waitmessage
		}
	}
	elif(flag(FLAG_CLOWNS) == TRUE && flag(FLAG_CLOWN_ONE) == FALSE){
		msgbox("Hi, there. You should stick around.\n"
        "We’re doing a Pokétch campaign soon.\p"
        "Before it starts, I think you should\n"
        "brush up at the Trainers’ School.",MSGBOX_NPC)
			waitmessage
	}
	else
	{
			msgbox("If the Pokémon’s type matches its\n"
        "move’s type, that move is made much\l"
        "more powerful!",MSGBOX_NPC)
			waitmessage

	}
	release
}

script Clown_Three_text {
	lock
	if(flag(FLAG_CLOWN_THREE) == FALSE)
	{
		applymovement(Clown_Three, moves(face_player))
		msgbox("Hi! I’m a Pokétch campaign clown!\n"
        "Let’s roll out my question!\p"
        "Can a Pokémon hold an item?",MSGBOX_YESNO)
		if(var(VAR_RESULT) == 1)
		{
		msgbox("Ding-ding!\n"
		"You’re absolutely correct!")
		msgbox("A Pokémon may hold a single item.\p"
        "Some items become effective as soon\n"
        "as they are held by a Pokémon.\p"
        "Berries are eaten by Pokémon as\n"
        "necessary during battle.\p")
			msgbox("Here you go!\n"
			"Your Pokétch Coupon!")
			waitmessage
			setflag(FLAG_CLOWN_THREE)
			giveitem(ITEM_AURORA_TICKET)
		}
		elif(var(VAR_RESULT) == 0)
		{
			msgbox("Bzzzzt!\n"
			"That’s the wrong answer...",MSGBOX_AUTOCLOSE)
			waitmessage
		}
	}
	else
	{
			msgbox("If the Pokémon’s type matches its\n"
        "move’s type, that move is made much\l"
        "more powerful!",MSGBOX_NPC)
			waitmessage

	}
	release
}


