}

script Jubilife_lookerStopTalk {
	lock
	if(var(VAR_JUBILIFE_STATE) == 1)
	{
		setspeaker(SP_NAME_LOOKER)
        msgbox("Ah, it is you! Have no fear.\n"
        "There are no shady characters about.\p"
        "Incidentally, have you visited the\n"
        "Trainers’ School?\p"
        "Did your friend not guide you there\n"
        "earlier?",MSGBOX_NPC)
		waitmessage
	}
	elif(var(VAR_JUBILIFE_STATE) == 3)
	{
		setspeaker(SP_NAME_LOOKER)
        msgbox("Ah, it is you! Have no fear.\n"
        "There are no shady characters about.\p"
        "Incidentally, have you not obtained\n"
        "a Pokétch?\p"
        "I believe a Pokétch is now free in\n"
        "exchange for some Coupons?",MSGBOX_NPC)
		waitmessage
	}

	release
}

script Jubilife_TradeStation_Stop {
	lock
	if(flag(FLAG_DEFEATED_RUSTBORO_GYM) == TRUE)
	{

	}
	applymovement(4, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
	waitmovement
        msgbox("Past here is the Local Trading Terminal\n"
        "your gateway to the community!\p"
        "Oh, I’m sorry, you don’t have\n"
        "any Gym Badges.\p"
        "The Local Trading Terminal is off-limits\n"
        " if you don’t have a Gym Badge. Sorry!",MSGBOX_AUTOCLOSE)
	waitmessage
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
	waitmovement
	release
}

script Jubilife_Poketkch_man {
	lockall
	applymovement(poketch_president_outside, moves(face_down,emote_exclamation_mark))
	playse(SE_PIN) 
    waitse
	waitmovement
	applymovement(poketch_president_outside, moves(walk_down*3))
	waitmovement
	call(Jubilife_Poketkch_man_Cont)
}

