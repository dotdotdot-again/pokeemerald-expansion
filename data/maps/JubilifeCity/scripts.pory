	waitmovement
	setspeaker(SP_NAME_LOOKER)
        msgbox("Tell me, have you not obtained\n"
        "a Pokétch?\p"
        "I believe a Pokétch is now free in\n"
        "exchange for some Coupons?",MSGBOX_AUTOCLOSE)
