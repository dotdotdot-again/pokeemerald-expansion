script JubilifeCity_Text_CanYouTellMeWhatTypeOfPokemonYouLike {
	lock
	applymovement(5, moves(face_player))
	msgbox("The way you look...\n"
        "You’re obviously a Trainer!\p"
        "Can you tell me what type of Pokémon\n"
        "you like?")
	multichoice(25,5,MULTI_FIRE_WATER_GRASS,1)
	closemessage
	if(var(VAR_RESULT) == 0)
    {
        msgbox("The Fire type?\n"
        "You must have a fiery personality.\p"
        "You’d better watch out that fire isn’t\n"
        "doused by water, though.",MSGBOX_AUTOCLOSE)
		waitmessage
	}
	elif(var(VAR_RESULT) == 1)
    {
        msgbox("A person that likes the Water type\n"
        "must be somewhat cool.\p"
        "But beware of being drained dry by\n"
        "thirsty grass.",MSGBOX_AUTOCLOSE)
		waitmessage
	}
	elif(var(VAR_RESULT) == 1)
    {
        msgbox("You chose the Grass type?\n"
        "No wonder you look so calm.\p"
        "I think you need to watch out you don’t\n"
        "get burned by fire.",MSGBOX_AUTOCLOSE)
		waitmessage
	}

	release
}