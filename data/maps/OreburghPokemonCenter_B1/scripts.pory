mapscripts OreburghPokemonCenter_B1_MapScripts {}

script reburghPokemonCenter_B1_WelcomeTemp {
    lock
    buffernumberstring(STR_VAR_1, VAR_PLAYER_POINTS)
    msgbox("Hello and welcome to the game hub\n"
    "you have {STR_VAR_1} points.\p"
    "you'll be able to buy stuff from me with\n"
    "points in a later version of the game.",MSGBOX_NPC)
    release
    
}

script OreburghPokemonCenter_B1_Snake {
    lock
    showmoneybox(0,0,0)
    msgbox("It's an Onix arcade machine that costs\n"
    "100 to per play, do you wanna play?",MSGBOX_YESNO)
    if(var(VAR_RESULT) == TRUE){
        checkmoney(100,1)
        if(var(VAR_RESULT) == TRUE){
            removemoney(100,0)
            playse(SE_SHOP)
            updatemoneybox
            waitse
            hidemoneybox
            setvar(VAR_TEMP_5,0)
            buffernumberstring(STR_VAR_1, VAR_PLAYER_POINTS)
            playbgm(MUS_NONE,FALSE)
            special(StartSnake)
            waitstate
            savebgm(MUS_DUMMY)
            fadedefaultbgm
            while{
                if(var(GAME_CORNER_VAR_WINNINGS) == 0){
                    break
                }
                addvar(VAR_PLAYER_POINTS, 1)
                addvar(VAR_TEMP_5, 1)
                if(var(VAR_TEMP_5) == GAME_CORNER_VAR_WINNINGS){
                    break
                }
            }
            buffernumberstring(STR_VAR_2, GAME_CORNER_VAR_WINNINGS)
            buffernumberstring(STR_VAR_1, VAR_PLAYER_POINTS)
            msgbox("You got {STR_VAR_2}\n"
            "You now have {STR_VAR_1} points",MSGBOX_NPC)
            setvar(GAME_CORNER_VAR_WINNINGS,0)
            }
        else {
            hidemoneybox
            msgbox("You don't seem to have enough.",MSGBOX_SIGN)
        }
    }
    hidemoneybox
    release
}

script OreburghPokemonCenter_B1_OtherGame {
    lock
    msgbox("Its another arcade game".MSGBOX_SIGN)
    release
}

script kidPlayingOre {
    lock
    applymovement(3, moves(face_player))
    waitmovement
    msgbox("This Onix game is so fun!\p"
    "You should give it a try on the\n"
    "machine next to mine!\p"
    "It'd say you should also try the\n"
    "Block stacking game but it think my\l"
    "dad's gonna be trying that one for\lawhile.")
    waitmessage
    applymovement(3, moves(face_up))
    waitmovement
    release
}


script Mom_B1_Ore {
    lock
    msgbox("My kid really does take after is\n"
    "father doesn't it?\p"
    "though it seems he got his gaming skills\n"
    "from his mother.",MSGBOX_NPC)
    release
}

script GuyPlayingOre {
    lock
    msgbox("Ugh! Ragh! Agh\n"
    "This game is impossble!\p"
    "How did my kid make it look\n"
    "so easy earlier!",MSGBOX_AUTOCLOSE)
    waitmessage
    release
}

script Ore_b1_meow {
    lock
    playmoncry(SPECIES_GLAMEOW,0)
    msgbox("Meeeow!",MSGBOX_NPC)
    release
}
