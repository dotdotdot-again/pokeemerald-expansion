mapscripts Oreburgh_Mine_F2_MapScripts {}

script MineF2_Roark_Event {
    lockall
    applymovement(Roark_Mine, moves(face_down,delay_16,delay_16,face_right,delay_16))
    waitmovement
    setspeaker(SP_NAME_ROARK)
    msgbox("OK, stand back and watch this.\p"
        "Using the hidden move Rock Smash,\n"
        "a boulder blocking your way...",MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_M_ROCK_THROW)
    applymovement(1,moves(rock_smash_break) )
    waitmovementall
    removeobject(1)
    setflag(FLAG_TEMP_11)
    waitse
    applymovement(Roark_Mine, moves(face_down))
    setspeaker(SP_NAME_ROARK)
    msgbox("Fallen boulders need to be smashed\n"
        "so they’re out of the way.\p"
        "If you could get the Badge from\n"
        "the Gym in town, you’d be able\l"
        "to do this too.\p"
        "Of course, you’d have to beat the\n"
        "Gym Leader first. That’d be me!",MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(Roark_Mine, moves(walk_right*8))
    waitmovement
    removeobject(Roark_Mine)
    setflag(FLAG_ROARK_OUT_OF_THE_MINE)
    releaseall 
}

script Oreburgh_Mine_Worker_Mason {
    lock
    trainerbattle_single(TRAINER_COLE, "I’m gonna let you in on a secret...\n"
                "I snuck my Pokémon to work!", "Well, now aren’t you something!")
    msgbox("OK, OK, time for work! I’ll work up\n"
                "a thirst with my Pokémon!",MSGBOX_NPC)
    waitmessage
    release
}

script Oreburgh_Mine_Worker_Colin {
    lock
    trainerbattle_single(TRAINER_JEFF, "Fine, all righty then.\n"
                "Just a quick battle on my break!", "Wahaha!\n"
                "Mercy, I cry mercy!")
    msgbox("I’d better get on back to work...\p"
                "You know, I’d rather be traveling\n"
                "around with Pokémon the way you do.",MSGBOX_NPC)
    waitmessage
    release
}

script OreburghMineB2F_Text_IMetTheseMachopOnRoute207 {
    lock
    msgbox("I met these MACHOP on Route 207.\p"
        "They’ve now become my most trusted\n"
        "partners!",MSGBOX_NPC)
    release
}

