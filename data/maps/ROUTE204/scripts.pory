mapscripts ROUTE204_MapScripts {}

script Route204South_Text_Rt204JubilifeCity {
    lock
    msgbox("Rt. 204\n"
        "Jubilife City",MSGBOX_SIGN)
    release
}

script Route204South_Text_RavagedPath {
    lock
    msgbox("Rt. 204\n"
        "Jubilife City",MSGBOX_SIGN)
    release
}

script Route204South_Text_ThereAreBouldersBlockingTheWayInsideTheCavern {
    lock
    msgbox("There are boulders blocking the way\n"
        "inside the cavern...\p"
        "I think a Pokémon’s hidden move will be\n"
        "able to smash those boulders, though.",MSGBOX_NPC)
}

script Route204_Lass_Sarah {
    trainerbattle_single(TRAINER_SALLY, "Oh, a weak-looking Trainer...\n"
                "Do you want to have a go?", "Aww...\n"
                "I should have said no.")
    msgbox("Oh, you’re so mean!\n"
                "I just started training Pokémon!\n",MSGBOX_NPC)
    waitmessage
    release
}

script Route204_Lass_Samantha {
    trainerbattle_single(TRAINER_ROBIN, "May I please trouble you for a\n"
                "battle?", "Oh...\n"
                "You’re so strong...")
    msgbox("Maybe I could have won if my Pokémon\n"
                "was holding a Berry...",MSGBOX_NPC)
    waitmessage
    release
}

script Route204_Youngster_Tyler {
    trainerbattle_single(TRAINER_EDDIE, "I’ll beat you with the MAGIKARP my dad\n"
                "gave me!", "But they’re Pokémon I got from my\n"
                "dad...")
    msgbox("Who gave you your first Pokémon?\p"
                "Your first Pokémon is the one with\n"
                "the most fond memories, I think.",MSGBOX_NPC)
    waitmessage
    release
}