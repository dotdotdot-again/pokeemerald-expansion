mapscripts OreburghGate_MapScripts {}

script OreburghGate_Trigger_one {
    lockall
    applymovement(8, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitse
    waitmovement
    applymovement(8, moves(walk_down))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovementall
    call(OreburghGate1F_Text_SoLetMeMakeAGiftOfThisHiddenMachineToYou)
}

script OreburghGate1F_Text_SoLetMeMakeAGiftOfThisHiddenMachineToYou {
    if(flag(FLAG_GOT_HM06) == true)
    {
        lock
         msgbox("That Hidden Machine, or HM for short,\n"
        "contains the hidden move Rock Smash.\p"
        "A Pokémon learning Rock Smash can\n"
        "smash small boulders in the field.\p"
        "But the Trainer has to have \n"
        "the Gym Badge from Oreburgh City.\p"
        "If you don’t have that Badge, you\n"
        "can’t make a Pokémon use the hidden\l"
        "move Rock Smash outside of battle.",MSGBOX_AUTOCLOSE)
        waitmessage
        release
    }
    else{
    lockall
    applymovement(8, moves(face_player))
    msgbox("That sparkling new Pokétch!\n"
        "Your awkwardness as a traveler!\p"
        "Hmm... You’re still a pretty new\n"
        "Trainer, aren’t you?\p"
        "But it’s all good! You’re a new fellow\n"
        "friend of Pokémon!\p"
        "So, let me make a gift of this Hidden\n"
        "Machine to you!",MSGBOX_AUTOCLOSE)
        waitmessage
        giveitem(ITEM_HM06)
        setflag(FLAG_GOT_HM06)
    msgbox("That Hidden Machine, or HM for short,\n"
        "contains the hidden move Rock Smash.\p"
        "A Pokémon learning Rock Smash can\n"
        "smash small boulders in the field.\p"
        "But the Trainer has to have \n"
        "the Gym Badge from Oreburgh City.\p"
        "If you don’t have that Badge, you\n"
        "can’t make a Pokémon use the hidden\l"
        "move Rock Smash outside of battle.",MSGBOX_AUTOCLOSE)
        waitmessage
        setvar(VAR_JUBILIFE_STATE,6)
        releaseall
        
    }

}
