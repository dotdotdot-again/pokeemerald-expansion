mapscripts Route202_MapScripts {

}

script testBattle {

    trainerbattle_single(TRAINER_CALVIN_1, "This is a test fight!", "Test over!")
    msgbox("This is a post battle script!",MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

script goSeeYourMom 
{
    lockall
    applymovement(LudaRoute202, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
    waitmovementall
    applymovement(LudaRoute202, moves(walk_right*4))
    waitmovementall
    checkplayergender
        if(var(VAR_RESULT) == 0)
    {
        //Dawn Script if Player Male
        setspeaker(SP_NAME_DAWN)
        msgbox(Route202_Text_DawnYouShouldGoTellYourFamily,MSGBOX_AUTOCLOSE)
        waitmessage
    }
    elif(var(VAR_RESULT) == 1)
    {
        //Lucas Script if Player female
        setspeaker(SP_NAME_LUCAS)
        msgbox(Route202_Text_LucasWhyDontYouGoTellYourFamily,MSGBOX_AUTOCLOSE)
        waitmessage
    }
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right,face_left))
    applymovement(LudaRoute202, moves(walk_right,walk_left*5,face_right))
    waitmovementall
    releaseall
}

