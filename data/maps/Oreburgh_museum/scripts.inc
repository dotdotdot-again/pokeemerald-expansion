# 12 "data/maps/Oreburgh_museum/scripts.pory"
	.string "Hello, hello!\n"
	.string "How are you?\p"
	.string "I study Pokémon Fossils!\n"
	.string "Me! Right here and now!\p$"

MiningMuseum_Text_CoalExhibit1_Text_0:
# 21 "data/maps/Oreburgh_museum/scripts.pory"
	.string "Whoa! So this is coal?\n"
	.string "I never expected something this big!\p"
	.string "And that color!\n"
	.string "It really is as black as they say!$"

