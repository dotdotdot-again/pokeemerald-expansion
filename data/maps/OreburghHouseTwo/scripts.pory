mapscripts OreburghHouseTwo_MapScripts {}

script OreburghCityNorthHouse1F_Text_WouldYouBeWillingToTradeYourMachopForMyAbra {
    lock
    msgbox("Listen, listen. Do you have a Pokémon\n"
        "called MACHOP?\p"
        "Would you be willing to trade your\n"
        "MACHOP for my ABRA?INSERT TRADE EVENT",MSGBOX_NPC)
        
    release
}

script OreburghCityNorthHouse1F_Text_APokemonObtainedInATradeGrowsQuickly {
    lock
    msgbox("A Pokémon obtained in a trade grows\n"
        "quickly.\p"
        "But if a Pokémon grows too much, it may\n"
        "ignore the Trainer.\p"
        "Of course, it won’t matter if you have\n"
        "lots of Gym Badges.",MSGBOX_NPC)
    release
}

script OreburghCityNorthHouse1F_Text_WhenYouTradeAPokemonTheItemItsHoldingIsTradedAsWell {
    lock
    msgbox("When you trade a Pokémon, the item it’s\n"
        "holding is traded as well.\p"
        "That’s pretty cool, huh?\p"
        "It means you can send an item as a gift\n"
        "along with your Pokémon in a trade!",MSGBOX_NPC)
    release
}

script Oreburgh_Trade_Girl {
    lockall
    if(flag(FLAG_RUSTBORO_NPC_TRADE_COMPLETED) == FALSE) {
        applymovement(2, moves(face_player))
        ingame_trade(INGAME_TRADE_ABRA,"Listen, listen. Do you have a Pokémon\n"
        "called Machop?\p"
        "Would you be willing to trade your\n"
        "Machop for my Abra?",Oreburgh_Trade_Girl_Decline,Oreburgh_Trade_Girl_Wrong,"Thanks to Pokémon, I got to be\n"
        "friends with you!")
        waitmessage
        setflag(FLAG_RUSTBORO_NPC_TRADE_COMPLETED)
        closemessage
        releaseall

    }
    else{
        msgbox("Thanks to Pokémon, I got to be\n"
        "friends with you!",MSGBOX_NPC)
    }

    
}

script Oreburgh_Trade_Girl_Wrong {
    msgbox("What I asked for was a Machop...",MSGBOX_NPC)

}

script Oreburgh_Trade_Girl_Decline {
    msgbox("Oh, OK...\n"
        "Well, I can’t make you trade me.\p"
        "But if you change your mind,\n"
        "I’ll be right here waiting!",MSGBOX_NPC)

}