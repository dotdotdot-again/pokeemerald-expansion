mapscripts SandgemPokemonCenter_MapScripts {
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script Sandgem_PokeCenter_Nurse {
    setvar(VAR_0x800B, 1)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
    waitbuttonpress
    setrespawn(HEAL_LOCATION_SANDGEM_TOWN)
    release
    end
}

script SandgemTownPokecenter1F_Text_ThatLadyAtTheCounterWillHealYourPokemon {
    lock
    msgbox("Talk to that nice lady at the counter\n"
        "and hand her your Pokémon.\p"
        "She’ll heal your Pokémon to perfect\n"
        "health in no time at all!",MSGBOX_NPC)
    release
}

script SandgemTownPokecenter1F_Text_DoYouSeeThatPCOverThere {
    lock
    msgbox("Do you see that PC over there?\n"
        "That fancy blue one?\p"
        "If you’ve got Pokémon with you,\n"
        "it’s free to use.",MSGBOX_NPC)
    release
}


script SandgemTownPokecenter1F_Text_TheTopFloorIs {
    lock
    msgbox("The top floor of any Pokémon Center\n"
        "is the Pokémon Communication Club.\p"
        "There, you can get all sorts of\n"
        "useful items.",MSGBOX_NPC)
    release
}


script SandgemTownPokecenter1F_UndergoundGuy_Stop {
    lock
    msgbox("Sorry but the basement floor is still \n"
    "being remodeled.\p"
    "You'll have to comeback another time.",MSGBOX_NPC)
    release
}


