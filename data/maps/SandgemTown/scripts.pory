mapscripts SandgemTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: OnTransition_Sandgem
    	MAP_SCRIPT_ON_FRAME_TABLE [
	VAR_TEMP_2, 0:EveryFrame_Sandgem
	]

}

script OnTransition_Sandgem{
	
	setvar(VAR_TEMP_2,0)
    
}

script EveryFrame_Sandgem {
    if(var(VAR_SANDGEM_INTRO_STATE) == 1)
    {
        call(Sandgem_After_Lab_Event)

    }
    else{
    setvar(VAR_TEMP_2, 1)
    }
}

script Sandgem_LuDa_Walk_Mid {
    lockall
    applymovement(SandgemLuda, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
    waitmovement
    applymovement(SandgemLuda, moves(walk_left*3))
    waitmovement
    call(Sandgem_LuDa_Cont)

}

script Sandgem_LuDa_Walk_Top {
    lockall
    applymovement(SandgemLuda, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down,face_right))
    applymovement(SandgemLuda, moves(walk_left*3))
    waitmovementall
    call(Sandgem_LuDa_Cont)

}

script Sandgem_LuDa_Walk_Bottom {
    lockall
    applymovement(SandgemLuda, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up,face_right))
    applymovement(SandgemLuda, moves(walk_left*3))
    waitmovementall
    call(Sandgem_LuDa_Cont)

}

script Sandgem_LuDa_Cont {
    checkplayergender
    if(var(VAR_RESULT) == 0)
    {
        //Dawn Script if Player Male
        setspeaker(SP_NAME_DAWN)
        msgbox(SandgemTown_Text_DawnTheProfessorIsWaiting,MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(SandgemLuda, moves(walk_right*4,face_up))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right*4,face_up))
        waitmovementall
        setspeaker(SP_NAME_DAWN)
        msgbox(SandgemTown_Text_DawnThisIsItOurPokemonResearchLab)
        waitmessage
        opendoor(10,9)
        waitdooranim
        clearflag(FLAG_HIDE_ROUTE_103_RIVAL)
        addobject(Sandgem_Barry)
        applymovement(Sandgem_Barry, moves(walk_fast_down))
        msgbox("THUD!!!",MSGBOX_AUTOCLOSE)
        waitmessage
        playbgm(MUS_DP_RIVAL,0)
        applymovement(Sandgem_Barry, moves(emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        waitmovement
        setspeaker(SP_NAME_BARRY)
        msgbox("What the...\p"
        "Oh, it’s you, {PLAYER}!\p"
        "That old guy... He’s not scary so\n"
        "much as he is totally out there!\p"
        "Aww, it doesn’t matter, {PLAYER}.\n"
        "I’m out of here. See you later!",MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(Sandgem_Barry, moves(walk_fast_right*2,walk_fast_down,walk_fast_right*6))
        applymovement(SandgemLuda, moves(delay_4,face_right))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_4,face_right))
        waitmovementall
        fadedefaultbgm
        setflag(FLAG_HIDE_ROUTE_103_RIVAL)
        setspeaker(SP_NAME_DAWN)
        msgbox(SandgemTown_Text_DawnLetsGoInside,MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(SandgemLuda, moves(walk_up,walk_fast_left,walk_up))
        waitmovement
        removeobject(SandgemLuda)
        setflag(LUDA_SANDGEM)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_4,walk_up*2))
        waitmovement
        fadescreen(FADE_TO_BLACK)
        playse(SE_EXIT)
        waitse
        warpcontinuescript(MAP_SANDGEM_HOUSE_LAB,7,14,EnteringSandgemLab)
    }
    elif(var(VAR_RESULT) == 1)
    {
        //Lucas Script if Player female
        setspeaker(SP_NAME_LUCAS)
        msgbox(SandgemTown_Text_LucasTheProfsWaitingToSeeYou,MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(SandgemLuda, moves(walk_right*4,face_up))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right*4,face_up))
        waitmovementall
        setspeaker(SP_NAME_LUCAS)
        msgbox(SandgemTown_Text_LucasSeeThisIsIsOurPokemonResearchLab)
        waitmessage
        opendoor(10,9)
        waitdooranim
        clearflag(FLAG_HIDE_ROUTE_103_RIVAL)
        addobject(Sandgem_Barry)
        applymovement(Sandgem_Barry, moves(walk_fast_down))
        msgbox("THUD!!!",MSGBOX_AUTOCLOSE)
        waitmessage
        playbgm(MUS_DP_RIVAL,0)
        applymovement(Sandgem_Barry, moves(emote_exclamation_mark))
        playse(SE_PIN) 
        waitse
        waitmovement
        setspeaker(SP_NAME_BARRY)
        msgbox("What the...\p"
        "Oh, it’s you, {PLAYER}!\p"
        "That old guy... He’s not scary so\n"
        "much as he is totally out there!\p"
        "Aww, it doesn’t matter, {PLAYER}.\n"
        "I’m out of here. See you later!",MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(Sandgem_Barry, moves(walk_fast_right*2,walk_fast_down,walk_fast_right*6))
        applymovement(SandgemLuda, moves(delay_4,face_right))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_4,face_right))
        waitmovementall
        fadedefaultbgm
        setflag(FLAG_HIDE_ROUTE_103_RIVAL)
        setspeaker(SP_NAME_LUCAS)
        msgbox(SandgemTown_Text_LucasLetsGoIn,MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(SandgemLuda, moves(walk_up,walk_fast_left,walk_up))
        waitmovement
        removeobject(SandgemLuda)
        setflag(LUDA_SANDGEM)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_4,walk_up*2))
        waitmovement
        fadescreen(FADE_TO_BLACK)
        playse(SE_EXIT)
        waitse
        warpcontinuescript(MAP_SANDGEM_HOUSE_LAB,7,14,EnteringSandgemLab)
    }
}

script EnteringSandgemLab {
    fadescreen(FADE_FROM_BLACK)
    call(Intro_In_Sandgem_Lab)
    
}

script Sandgem_After_Lab_Event {
    lockall
    applymovement(SandgemLuda, moves(face_up))
    waitmovement
    opendoor(10,9)
    addobject(Sandgem_Rowan_Outside)
    clearflag(BARRY_INTRO_TWO)
        setspeaker(SP_NAME_ROWAN)
    msgbox("{PLAYER}!!!!!!!!!",MSGBOX_AUTOCLOSE) 
    waitmessage
    applymovement(SandgemLuda, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    playse(SE_PIN) 
    waitse
    waitmovementall
    applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_8,face_up))
    waitmovement
        setspeaker(SP_NAME_ROWAN)
    msgbox("I have something good here.\n"
        "You should take this as well.",MSGBOX_AUTOCLOSE) 
    waitmessage
    giveitem(ITEM_TM27,1)
        setspeaker(SP_NAME_ROWAN)
    msgbox("That is a Technical Machine.\n"
        "That one contains the move Return.\p"
        "Using a Technical Machine, or TM for\n"
        "short, teaches a move instantly to\l"
        "a Pokémon.\p"
        "The move Return gains power the more\n"
        "friendly your Pokémon is with you.\p"
        "It’s up to you, of course, if you want\n"
        "to use that TM or not.\p"
        "I’ll send you off with the wish that\n"
        "your journey will be fun.",MSGBOX_AUTOCLOSE) 
    waitmessage
    applymovement(Sandgem_Rowan_Outside, moves(face_up,delay_8))
    waitmovement
    removeobject(Sandgem_Rowan_Outside)
    setflag(BARRY_INTRO_TWO)
    closedoor(10,9)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_8))
    waitmovement
        checkplayergender
    if(var(VAR_RESULT) == 0)
    {
        //Dawn Script if Player Male
        setspeaker(SP_NAME_DAWN)
        msgbox(SandgemTown_Text_DawnIDidntKnowTheProfessorHadTMs,MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
        //applymovement(SandgemLuda, moves(walk_up))
        waitmovementall
        setspeaker(SP_NAME_DAWN)
        msgbox("Ok, {PLAYER}!\n"
        "Do you want me to show you around\l"
        "town?",MSGBOX_YESNO)
            if(var(VAR_RESULT) == 1)
            {
                playbgm(MUS_DP_FOLLOW_ME,0)
                setspeaker(SP_NAME_DAWN)
                msgbox("Ok, follow me!",MSGBOX_AUTOCLOSE)
                waitmessage
                applymovement(SandgemLuda, moves(walk_right*10,face_up))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down,walk_right*9,face_up))
                waitmovementall
                setspeaker(SP_NAME_DAWN)
                msgbox(SandgemTown_Text_DawnThisIsThePokemonCenter,MSGBOX_AUTOCLOSE)
                waitmessage
                applymovement(SandgemLuda, moves(walk_right*10,face_up))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right*10,face_up))
                waitmovementall
                setspeaker(SP_NAME_DAWN)
                msgbox(SandgemTown_Text_DawnThisIsThePokeMart)
                waitmessage
                applymovement(SandgemLuda, moves(face_left))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
                waitmovementall
                applymovement(SandgemLuda, moves(emote_exclamation_mark))
                playse(SE_PIN) 
                waitse
                setspeaker(SP_NAME_DAWN)
                msgbox(SandgemTown_Text_DawnLetYourFamilyKnowYoureHelpingProfRowan,MSGBOX_AUTOCLOSE)
                waitmessage
                applymovement(SandgemLuda, moves(walk_down,walk_left*5,walk_up*6))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down,delay_8,face_right))
                waitmovementall
                fadedefaultbgm
                removeobject(SandgemLuda)
                setflag(LUDA_SANDGEM)
            }
            elif(var(VAR_RESULT) == 0)
            {
            setspeaker(SP_NAME_LUCAS)
            msgbox("Ok... no problem")
            waitmessage
            applymovement(SandgemLuda, moves(emote_exclamation_mark))
            playse(SE_PIN) 
            waitse
            setspeaker(SP_NAME_DAWN)
            msgbox(SandgemTown_Text_DawnLetYourFamilyKnowYoureHelpingProfRowan,MSGBOX_AUTOCLOSE)
            waitmessage
            setspeaker(SP_NAME_LUCAS)
            applymovement(SandgemLuda, moves(walk_right*8))
            waitmovement
            removeobject(SandgemLuda)
            setflag(LUDA_SANDGEM)
            }
    }
    elif(var(VAR_RESULT) == 1)
    {
        //Lucas Script if Player female
        setspeaker(SP_NAME_LUCAS)
        msgbox(SandgemTown_Text_LucasWellIllBeTheProfessorHadTMs,MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
        //applymovement(SandgemLuda, moves(walk_up))
        waitmovementall
        setspeaker(SP_NAME_LUCAS)
        msgbox("Hey, {PLAYER}!\n"
        "Do you want me to show you around\l"
        "town?",MSGBOX_YESNO)
            if(var(VAR_RESULT) == 1)
            {
                playbgm(MUS_DP_FOLLOW_ME,0)
                setspeaker(SP_NAME_LUCAS)
                msgbox("Ok, follow me!",MSGBOX_AUTOCLOSE)
                waitmessage
                applymovement(SandgemLuda, moves(walk_right*10,face_up))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down,walk_right*9,face_up))
                waitmovementall
                setspeaker(SP_NAME_LUCAS)
                msgbox(SandgemTown_Text_LucasThisIsThePokemonCenter,MSGBOX_AUTOCLOSE)
                waitmessage
                applymovement(SandgemLuda, moves(walk_right*10,face_up))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right*10,face_up))
                waitmovementall
                setspeaker(SP_NAME_LUCAS)
                msgbox(SandgemTown_Text_LucasThisIsThePokeMart)
                waitmessage
                applymovement(SandgemLuda, moves(face_left))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
                waitmovementall
                applymovement(SandgemLuda, moves(emote_exclamation_mark))
                playse(SE_PIN) 
                waitse
                setspeaker(SP_NAME_LUCAS)
                msgbox(SandgemTown_Text_LucasLetYourFamilyKnowYoureHelpingProfRowan,MSGBOX_AUTOCLOSE)
                waitmessage
                applymovement(SandgemLuda, moves(walk_down,walk_left*5,walk_up*6))
                applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down,delay_8,face_right))
                waitmovementall
                fadedefaultbgm
                removeobject(SandgemLuda)
                setflag(LUDA_SANDGEM)
            }
            elif(var(VAR_RESULT) == 0)
            {
            setspeaker(SP_NAME_LUCAS)
            msgbox("Ok, no worries")
            waitmessage
            applymovement(SandgemLuda, moves(emote_exclamation_mark))
            playse(SE_PIN) 
            waitse
            setspeaker(SP_NAME_LUCAS)
            msgbox(SandgemTown_Text_LucasLetYourFamilyKnowYoureHelpingProfRowan,MSGBOX_AUTOCLOSE)
            waitmessage
            applymovement(SandgemLuda, moves(walk_right*8))
            waitmovement
            removeobject(SandgemLuda)
            setflag(LUDA_SANDGEM)
            }
    }
    setvar(VAR_SANDGEM_INTRO_STATE,2)
    releaseall
}

//NPCs

script SandgemTown_Text_TheThingYouHaveItsAPokedexIsntIt {
    lock
    msgbox("That thing you have!\p"
        "It’s a Pokédex, isn’t it?!\p"
        "You’re off to see all kinds of\n"
        "Pokémon now! Lucky you!",MSGBOX_NPC)
    release
}

script SandgemTown_Text_IdBetterSaveThis {
    lock
    msgbox("So I don’t forget what’s happened,\n"
        "till now, I’d better save this...\p"
        "There!\n"
        "Now I can take a break.",MSGBOX_NPC)
    release
}

script SandgemTown_Text_PokemonAreSoCool {
    lock
    msgbox("Oh, wow!\n"
        "Pokémon are so cool!\p"
        "You can make yours battle and make\n"
        "them stronger!\p"
        "I wish I had some!\n"
        "It’s so cool!",MSGBOX_NPC)
    release
}

//Signs
script SandgemTown_Text_MapSign {
    lock
    msgbox("Sandgem Town\n"
        "Town of Sand!",MSGBOX_SIGN)
    release
}

script SandgemTown_Text_PokemonResearchLabSign {
    lock
    msgbox("Pokémon Research Lab",MSGBOX_SIGN)
    release
}

script SandgemTown_Text_CounterpartMailbox {
    lock
    checkplayergender
    if(var(VAR_RESULT) == 0)
    {
        //Dawn Script if Player Male
        msgbox("Dawn’s House",MSGBOX_SIGN)
    }
    elif(var(VAR_RESULT) == 1)
    {
        //Lucas Script if Player female
        msgbox("Lucas’s House",MSGBOX_SIGN)
    }
}

script SandgemTown_Text_PokeMartSign {
    lock
    msgbox("All Your Item Needs Fulfilled!\n"
        "Pokémon Mart",MSGBOX_SIGN)
    release
}

script SandgemTown_Text_PokemonCenterSign {
    lock
    msgbox("Heal Your Pokémon!\n"
        "Pokémon Center",MSGBOX_SIGN)
    release
}

//Gendered Text
//Dawn
text SandgemTown_Text_DawnTheProfessorIsWaiting {
        "Oh! There you are!\n"
        "Please, come with me!\l"
        "The professor is waiting!"
}

text SandgemTown_Text_DawnThisIsItOurPokemonResearchLab {
        "This is it!\n"
        "Our Pokémon Research Lab!\p"
        "Let’s go..."
}

text SandgemTown_Text_DawnLetsGoInside {
        "Wow, what was that?\p"
        "Your friend sure seems to be really\n"
        "impatient.\p"
        "Well, anyway...\n"
        "Let’s go inside."
}

//Dawn after lab

text SandgemTown_Text_DawnIDidntKnowTheProfessorHadTMs {
        "Oh, wow.\n"
        "I didn’t know the professor had TMs.\p"
        "Was he a Trainer when he was\n"
        "young...?"
}

text SandgemTown_Text_DawnIllActAsYourMentor {
        "OK, {PLAYER}, I’ll act as\n"
        "your mentor.\p"
        "I’ve got a bit more experience than\n"
        "you as a Trainer and as the professor’s\l"
        "assistant.\p"
        "OK, follow me!"
}

text SandgemTown_Text_DawnThisIsThePokemonCenter {
        "This building with the red roof is\n"
        "the Pokémon Center.\p"
        "It’s the place that heals Pokémon\n"
        "that have been hurt in battle.\p"
        "You can find a Pokémon Center in\n"
        "most towns."
}

text SandgemTown_Text_DawnThisIsThePokeMart {
        "The building with the blue roof over\n"
        "here is the Poké Mart.\p"
        "It’s a shop where you can buy and\n"
        "sell items and medicine.\p"
        "{PLAYER}, since you’re a novice\n"
        "Trainer, you won’t be able to buy\l"
        "many kinds of merchandise.\p"
        "Don’t let it bother you!"
}

text SandgemTown_Text_DawnLetYourFamilyKnowYoureHelpingProfRowan {
        "Oh, that’s right!\n"
        "{PLAYER}...\p"
        "Don’t you need to let your family\n"
        "know that you’re going to be helping\l"
        "Prof. Rowan with the Pokédex?\p"
        "You may need to go far away, so I\n"
        "think you should let someone know.\p"
        "Oh, but before you go, heal up your\n"
        "Pokémon at the Pokémon Center.\p"
        "It will be a lot less scary that way.\n"
        "OK, bye now!"
}

//Lucas
text SandgemTown_Text_LucasTheProfsWaitingToSeeYou {
        "Hi! I’ve been waiting for you!\n"
        "Please, come with me.\l"
        "The prof’s waiting to see you."
}

text SandgemTown_Text_LucasSeeThisIsIsOurPokemonResearchLab {
        "See? This is our Pokémon Research\n"
        "Lab.\p"
        "We’ll just go ahead and..."
}

text SandgemTown_Text_LucasLetsGoIn {
        "What was that?!\p"
        "Your friend always seems to be\n"
        "in such a rush.\p"
        "Anyway...\n"
        "Let’s go in."
}

//after lab event

text SandgemTown_Text_LucasWellIllBeTheProfessorHadTMs {
        "Well, I’ll be...\n"
        "The professor had TMs...?\p"
        "Next thing, he’ll tell me he battled\n"
        "when he was young."
}

text SandgemTown_Text_LucasIWantToShowYouAFewThings {
        "Hey, {PLAYER}!\n"
        "I want to show you a few things.\l"
        "So, follow me!"
}

text SandgemTown_Text_LucasThisIsThePokemonCenter {
        "This building with the red roof is\n"
        "the Pokémon Center.\p"
        "You can get your Pokémon healed if\n"
        "it’s been hurt in battle.\p"
        "You’ll find a Pokémon Center in most\n"
        "towns."
}

text SandgemTown_Text_LucasThisIsThePokeMart {
        "Over here, the building with the blue\n"
        "roof is the Poké Mart.\p"
        "It’s a shop where you can buy and\n"
        "sell all sorts of items.\p"
        "{PLAYER}, since you’re a rookie\n"
        "Trainer, you won’t be able to buy\l"
        "very much stuff.\p"
        "Don’t worry about it, OK?"
}

text SandgemTown_Text_LucasLetYourFamilyKnowYoureHelpingProfRowan {
        "Oh, yeah, right!\n"
        "{PLAYER}...\p"
        "You should let your family know\n"
        "you’re helping Prof. Rowan put\l"
        "together his Pokédex.\p"
        "Sometimes, you have to go far away,\n"
        "so you should let someone know.\p"
        "Oh, but first, go heal up your\n"
        "Pokémon at the Pokémon Center.\p"
        "You’ll be safe then.\n"
        "OK, be seeing you!"
      
}




script testingSomethingSandgem {
    setflag(B_FLAG_FOLLOWERS_DISABLED)
}

