script OreburghCity_Text_HereTakeOneOfThese {
    lock
    if(flag(FLAG_ITEM_ROUTE_111_HP_UP) == FALSE)
    {
    msgbox("There’s no question. This is hard,\n"
        "hard work.\p"
        "But working alongside Pokémon...\n"
        "It gives me a boost somehow.\p"
        "Here, take one of these.",MSGBOX_NPC)
        waitmessage
    giveitem(ITEM_SUPER_POTION)
    setflag(FLAG_ITEM_ROUTE_111_HP_UP)
    }
    else
    {
    msgbox("Feeling hale and hearty puts a smile\n"
        "on my face. And that makes me happy.",MSGBOX_NPC)
    }
    release
}

