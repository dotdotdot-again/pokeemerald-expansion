mapscripts OreburghCity_MapScripts {}

script Oreburgh_TownSign_one {
    lock
    msgbox("Oreburgh City\n"
    "City of Energy",MSGBOX_SIGN)
    release
}

script Oreburgh_GymSign {
    lock
    msgbox("Oreburgh City Pok\emon Gym\n"
    "Leader: Roark\l"
    "\qoCall me Roark the Rock!\qc",MSGBOX_SIGN)
    release
}

script Oreburgh_Younger_at_entrence {
    lock
    msgbox("Can I see your Trainer Case?\n"
    "It's got the Gym Badge you just\n"
    "won, right?",MSGBOX_NPC)
    release
}

script OreburghCity_Text_TheGymLeadersGoneOffToTheCoalMine {
    lock
    setspeaker(SP_NAME_BARRY)
    msgbox("Hunh?\p"
        "Oh, it’s you, {PLAYER}!\n"
        "You finally got here?\f"
        "You’re slow like always.\p"
        "But anyway, the Gym Leader’s tough!\n"
        "Like, seriously serious!\p"
        "If the Gym Leader’s this tough,\n"
        "I wonder how he compares to my dad...\p"
        "Huh?\n"
        "I just drifted there.\p"
        "Anyway, the Gym Leader’s gone off\n"
        "to the coal mine.\p"
        "If you want to take on the Gym Leader,\n"
        "you’d better go off to the mine!",MSGBOX_AUTOCLOSE)
    release

}