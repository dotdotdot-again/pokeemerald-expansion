mapscripts JubilifeSchool_MapScripts {}

script JubilifeSchool_Barry_Stuff {
    lockall
    applymovement(SchoolBarry, moves(face_player))
    setspeaker(SP_NAME_BARRY)
    msgbox("Hey, {PLAYER}!\n"
        "Did you come to study, too?\p"
        "I went ahead and memorized everything\n"
        "that was up on the blackboard.\p"
        "After all, it’s the Trainer’s job to\n"
        "avoid having their precious Pokémon\l"
        "hurt in battle, right?\p"
        "So, {PLAYER}, what brings you?\n"
        "Huh?\l"
        "You’ve got something for me?",MSGBOX_AUTOCLOSE)
    waitmessage
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("{PLAYER} Delivered the Parcel")
    removeitem(ITEM_PARCEL)
    waitfanfare
    closemessage
    setspeaker(SP_NAME_BARRY)
    msgbox("So, what is this...?\p"
        "Score!\n"
        "It’s a Town Map!\p"
        "Huh?!\n"
        "Why are there two in here?\p"
        "I like it a lot, but I don’t need two.\n"
        "Here, {PLAYER}, you take one!",MSGBOX_AUTOCLOSE)
    waitmessage
    giveitem(ITEM_TOWN_MAP)
    setspeaker(SP_NAME_BARRY)
    msgbox("Hmm...\p"
        "Well, according to the Town Map,\n"
        "I guess Oreburgh City is where\l"
        "I should be going next.\p"
        "There’s a Gym, so it’d be perfect for\n"
        "raising the Pokémon I just caught.\p"
        "Well, I’m on the road to becoming\n"
        "the greatest Trainer of all time!\p"
        "See you around",MSGBOX_AUTOCLOSE)
    waitmessage
    getobjectfacingdirection(OBJ_EVENT_ID_PLAYER,VAR_JUBILIFE_STATE)
    //buffernumberstring(STR_VAR_1,VAR_JUBILIFE_STATE)
    //msgbox("You are facing {STR_VAR_1}",MSGBOX_AUTOCLOSE)

    if(var(VAR_JUBILIFE_STATE) == 2)
    {
        applymovement(SchoolBarry, moves(walk_fast_right,walk_fast_down*7))
        waitmovement
    }
    else
    {
        applymovement(SchoolBarry, moves(walk_fast_down*7))
        waitmovement  
    }
    setvar(VAR_JUBILIFE_STATE,2)
    setflag(FLAG_WONDER_CARD_UNUSED_4)
    removeobject(SchoolBarry)
    releaseall
    


}
